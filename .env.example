# Copy this file to .env.local and fill in both values. .env.local is git-ignored.
# These are read only by the server code (server/ and api/), never sent to the browser.

# From https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# The SEC requires an app name and contact email on every request.
SEC_USER_AGENT="JPM AI Screener your-email@school.edu"
